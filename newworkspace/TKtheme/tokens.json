{
  "name": "taikang-quote-assistant",
  "source": "Sketch MeaXure export in index.html",
  "version": "1.0.0",
  "color": {
    "brand": {
      "primary": "#0060DB",
      "primaryPressed": "#0055C7",
      "primaryHover": "#1B7EFF",
      "primaryDeep": "#025CAB",
      "cyan": "#00D2DC"
    },
    "status": {
      "success": "#00E056",
      "warning": "#FFA028",
      "warningStrong": "#FDD908",
      "danger": "#FF3446",
      "dangerDeep": "#880F1E",
      "neutral": "#737578"
    },
    "text": {
      "primary": "#333333",
      "heading": "#111111",
      "secondary": "#666666",
      "tertiary": "#919294",
      "inverse": "#FFFFFF",
      "inverseSecondary": "rgba(255, 255, 255, 0.87)",
      "disabled": "rgba(0, 0, 0, 0.30)"
    },
    "surface": {
      "page": "#FFFFFF",
      "subtle": "#F8F9FA",
      "panel": "#F2F3F5",
      "selected": "#E9F1FE",
      "selectedStrong": "#CDEAFF",
      "dark": "#393D45",
      "darkDeep": "#262626",
      "darkSoft": "#30343C",
      "darkMuted": "#2B2F36"
    },
    "border": {
      "default": "#E3E5E8",
      "strong": "#DBDCE1",
      "divider": "#DDDEE4",
      "dark": "#CAD1DA",
      "panel": "rgba(202, 209, 218, 0.24)",
      "dividerDark": "rgba(202, 209, 218, 0.16)"
    },
    "chart": {
      "blue": "#1872F6",
      "purple": "#763DF2",
      "violet": "#A138F5",
      "indigo": "#6764F5",
      "gold": "#E9B842",
      "teal": "#02ADB0"
    },
    "overlay": {
      "mask": "rgba(0, 0, 0, 0.60)",
      "maskLight": "rgba(0, 0, 0, 0.30)",
      "shadow": "rgba(19, 20, 26, 0.05)"
    }
  },
  "font": {
    "family": {
      "base": "PingFang SC, Microsoft YaHei, Helvetica Neue, Arial, sans-serif",
      "number": "Helvetica Neue, Arial, sans-serif"
    },
    "size": {
      "xs": "12px",
      "sm": "13px",
      "md": "14px",
      "lg": "16px"
    },
    "lineHeight": {
      "tight": "12px",
      "compact": "14px",
      "normal": "16px",
      "relaxed": "20px",
      "loose": "28px"
    },
    "weight": {
      "regular": 400,
      "medium": 500
    }
  },
  "radius": {
    "none": "0",
    "xs": "1px",
    "sm": "2px",
    "md": "4px",
    "pill": "999px"
  },
  "space": {
    "xxs": "2px",
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "xxl": "24px"
  },
  "shadow": {
    "popup": "0 13px 24px 2px rgba(19, 20, 26, 0.05)",
    "screen": "0 2px 10px rgba(0, 0, 0, 0.20)",
    "panel": "0 8px 18px rgba(0, 0, 0, 0.18)"
  },
  "component": {
    "modal": {
      "width": "642px",
      "headerHeight": "30px",
      "background": "{color.surface.page}",
      "headerBackground": "{color.surface.panel}",
      "shadow": "{shadow.popup}"
    },
    "tab": {
      "height": "22px",
      "fontSize": "{font.size.lg}",
      "activeColor": "{color.text.heading}",
      "inactiveColor": "{color.text.secondary}",
      "indicatorColor": "{color.brand.primaryDeep}",
      "dividerColor": "{color.border.divider}"
    },
    "switch": {
      "width": "29px",
      "height": "14px",
      "trackOn": "{color.brand.primary}",
      "thumb": "{color.surface.page}"
    },
    "sectionTitle": {
      "accentWidth": "2px",
      "accentHeight": "12px",
      "accentColor": "{color.brand.primaryDeep}"
    }
  }
}
